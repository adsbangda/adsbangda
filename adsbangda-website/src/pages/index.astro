<script is:inline>
let currentLang = localStorage.getItem('adsbangda_lang') || 'id';

// ---- position mini-stat dividers at the exact midpoint of each gap ----
function positionMiniDividers(){
  if(window.innerWidth > 600) return; // desktop uses border-right instead
  const stats = document.querySelectorAll('.mini-stat');
  const dividers = [document.getElementById('miniDiv1'), document.getElementById('miniDiv2')];
  const container = document.querySelector('.mini-stats');
  if(!container || stats.length < 3) return;
  // batch all reads first to avoid forced synchronous layout
  const containerLeft = container.getBoundingClientRect().left;
  const rects = Array.from(stats).map(s => s.getBoundingClientRect());
  const positions = [];
  for(let i=0;i<2;i++){
    const mid = (rects[i].right + rects[i+1].left) / 2 - containerLeft;
    positions.push(mid);
  }
  // then batch all writes
  positions.forEach((mid, i)=>{ if(dividers[i]) dividers[i].style.left = mid + 'px'; });
}
window.addEventListener('load', positionMiniDividers);
window.addEventListener('resize', positionMiniDividers);
document.addEventListener('DOMContentLoaded', positionMiniDividers);
positionMiniDividers();
if(document.fonts && document.fonts.ready){
  document.fonts.ready.then(positionMiniDividers);
}


