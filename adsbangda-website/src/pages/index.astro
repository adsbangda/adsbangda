      <a href="layanan-digital-growth-consulting.html" class="service-card reveal" style="text-decoration:none;color:inherit;">
        <div class="service-icon">
          <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
