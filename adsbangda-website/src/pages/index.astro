}));

// ---- reveal on scroll ----
const revealEls = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
},{threshold:.15});
revealEls.forEach(el=>io.observe(el));

// ---- hero mini-stats: count-up animation on load ----
function animateStatItem(item){
  const target = parseInt(item.getAttribute('data-count'),10);
  const counterEl = item.querySelector('.counter');
  if(!counterEl || item.dataset.animating === '1') return;
  item.dataset.animating = '1';
  const duration = 1200;
  const start = performance.now();
  function tick(now){
    const progress = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    counterEl.textContent = Math.round(eased * target);
    if(progress < 1){
      requestAnimationFrame(tick);
    } else {
      counterEl.textContent = target;
      item.dataset.animating = '0';
    }
  }
  requestAnimationFrame(tick);
}
const heroStatItems = document.querySelectorAll('.mini-stat b[data-count]');
function startHeroStats(){
  setTimeout(()=>{ heroStatItems.forEach(item=>animateStatItem(item)); }, 250);
}
if(document.readyState === 'complete'){
  startHeroStats();
} else {
  window.addEventListener('load', startHeroStats);
}

const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// ---- marquee (JS-driven for pixel-accurate seamless loop) ----
const marqueeWords = ['SOSIAL MEDIA CONTENT','META ADS','KOL MANAGEMENT','COMPANY PROFILE DESIGN','CONTENT STRATEGY','BRAND IDENTITY'];
const marqueeTrack = document.getElementById('marqueeTrack');
function addMarqueeSet(){
  marqueeWords.forEach((w,i)=>{
    const s = document.createElement('span');
    s.textContent = '★ ' + w;
    if(i%3===0) s.classList.add('acc');
    marqueeTrack.appendChild(s);
  });
}
// Build one set first to measure its real width, then keep adding sets
// until the total track is comfortably wider than the viewport (works on ultra-wide monitors too)
addMarqueeSet();
let marqueeSetWidth = marqueeTrack.scrollWidth;
let setsNeeded = Math.max(2, Math.ceil((window.innerWidth * 2.2) / marqueeSetWidth));
for(let r=1;r<setsNeeded;r++){ addMarqueeSet(); }

function rebuildMarqueeSets(){
  // re-measure after fonts are fully loaded (font swap can change text width mid-flight)
  marqueeTrack.innerHTML = '';
  addMarqueeSet();
  marqueeSetWidth = marqueeTrack.scrollWidth;
  setsNeeded = Math.max(2, Math.ceil((window.innerWidth * 2.2) / marqueeSetWidth));
  for(let r=1;r<setsNeeded;r++){ addMarqueeSet(); }
}

if(!reduceMotion){
  const MARQUEE_SPEED = 45; // pixels per second
  let marqueePos = 0;
  let marqueeLastT = null;
  function marqueeTick(t){
    if(marqueeLastT !== null){
      const dt = (t - marqueeLastT) / 1000;
      marqueePos -= MARQUEE_SPEED * dt;
      if(marqueePos <= -marqueeSetWidth) marqueePos += marqueeSetWidth;
      marqueeTrack.style.transform = `translateX(${marqueePos}px)`;
    }
    marqueeLastT = t;
    requestAnimationFrame(marqueeTick);
  }
  requestAnimationFrame(marqueeTick);
  // Fonts loading asynchronously can change text width after our initial measurement,
  // which would desync the wrap point and show a gap. Re-measure once fonts settle.
  if(document.fonts && document.fonts.ready){
    document.fonts.ready.then(()=>{
      marqueePos = 0;
      rebuildMarqueeSets();
    });
  }
}

