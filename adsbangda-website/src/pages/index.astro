---
import Layout from "../layouts/Layout.astro";
const title = 'Adsbangda — Branding, Website & Digital Marketing Agency';
const description = 'Bangun brand yang lebih kuat lewat branding, pengembangan website, social media management, Meta Ads, desain kreatif, dan strategi konten pemasaran yang dirancang untuk bantu bisnis kamu tumbuh secara berkelanjutan.';
---
<Layout title={title} description={description} path="index.html" includeMainJs={false} ogImage="assets/img/og-homepage-office.jpg" ogImageAlt="Tim Adsbangda di kantor" ogImageWidth={1200} ogImageHeight={630}>
<Fragment slot="head-style">
<style>
.mini-stats{display:flex;gap:0;margin-top:52px;margin-bottom:8px;flex-wrap:nowrap;position:relative;}

.mini-stat{padding-right:clamp(10px,2.2vw,28px);margin-right:clamp(10px,2.2vw,28px);border-right:1px solid rgba(21,23,27,.15);min-width:0;}

.mini-stat:last-child{border-right:none !important;padding-right:0;margin-right:0;}

.mini-stat b{
  font-family:'IBM Plex Mono',monospace;font-size:clamp(17px,2.4vw,26px);font-weight:700;display:block;white-space:nowrap;
}

.mini-stat span{font-size:clamp(10.5px,1.15vw,12.5px);color:var(--muted);}

.mini-stat b .counter{font-size:inherit;color:inherit;display:inline;}

/* ---------- RUNNER DIVIDER (simple outlined stick figure, smooth run cycle) ---------- */
.runner-divider{position:relative;height:0;overflow:visible;}

.runner-track{position:absolute;left:0;right:0;top:-58px;height:100px;overflow:hidden;pointer-events:none;}

.runner-inner{position:relative;height:100%;width:100%;}

.runner-ground{position:absolute;left:0;right:0;bottom:22px;height:1px;background:rgba(21,23,27,.15);}

.runner-figure{position:absolute;left:0;bottom:22px;width:38px;height:58px;animation:runAcross 6s linear infinite;will-change:transform;}

.rf-leg-l{transform-origin:30px 54px;animation:legL 0.42s ease-in-out infinite;}

.rf-leg-r{transform-origin:30px 54px;animation:legR 0.42s ease-in-out infinite;}

.rf-arm-l{transform-origin:30px 29px;animation:armR 0.42s ease-in-out infinite;}

.rf-arm-r{transform-origin:30px 29px;animation:armL 0.42s ease-in-out infinite;}

@keyframes runAcross{
  from{transform:translateX(-8vw);}
  to{transform:translateX(104vw);}
}

@keyframes legL{0%,100%{transform:rotate(26deg);}50%{transform:rotate(-24deg);}}

@keyframes legR{0%,100%{transform:rotate(-24deg);}50%{transform:rotate(26deg);}}

@keyframes armL{0%,100%{transform:rotate(24deg);}50%{transform:rotate(-22deg);}}

@keyframes armR{0%,100%{transform:rotate(-22deg);}50%{transform:rotate(24deg);}}

@media (prefers-reduced-motion:reduce){
  .runner-figure,.rf-leg-l,.rf-leg-r,.rf-arm-l,.rf-arm-r{animation:none;transform:translateX(45vw);}
}

@media (max-width:640px){
  .runner-figure{width:32px;height:48px;}
}

/* ---------- PHONE MOCK CLUSTER ---------- */
.growth-stage{display:flex;justify-content:center;align-items:center;padding:20px 0;}

.growth-scene{
  position:relative;width:420px;height:460px;
}

.growth-chart-bg{position:absolute;inset:0;width:100%;height:100%;opacity:.8;}

.growth-floaters{position:absolute;inset:0;pointer-events:none;}

.gf{position:absolute;font-size:26px;animation:gfFloat 4.5s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(21,23,27,.15));}

.gf-1{top:8%;left:6%;animation-delay:0s;}

.gf-2{top:14%;right:10%;font-size:20px;color:var(--yellow);animation-delay:1.1s;}

.gf-3{bottom:46%;right:2%;animation-delay:2.1s;}

.gf-4{top:44%;left:0%;font-size:16px;color:var(--coral);animation-delay:3s;}

@keyframes gfFloat{
  0%,100%{transform:translateY(0) rotate(0deg);}
  50%{transform:translateY(-14px) rotate(6deg);}
}

.growth-stairs{position:absolute;left:20px;bottom:30px;width:380px;height:400px;}

.stair{
  position:absolute;height:34px;border-radius:8px 8px 0 0;
  box-shadow:inset 0 -6px 0 rgba(0,0,0,.14), 0 14px 22px -10px rgba(21,23,27,.35);
}

.stair-1{left:0px;bottom:0px;width:78px;background:var(--ink);}

.stair-2{left:74px;bottom:50px;width:78px;background:#3a3f47;}

.stair-3{left:148px;bottom:100px;width:78px;background:var(--teal);}

.stair-4{left:222px;bottom:150px;width:78px;background:var(--coral);}

.stair-5{left:296px;bottom:200px;width:78px;background:var(--yellow);}

.stick-figure{position:absolute;left:14px;bottom:34px;width:52px;height:78px;z-index:5;animation:climbStairs 5.8s cubic-bezier(.45,0,.4,1) infinite;will-change:transform;}

.sf-arm-l{animation:armSwing 0.5s ease-in-out infinite alternate;transform-origin:30px 32px;}

.sf-arm-flag{animation:armSwing 0.5s ease-in-out infinite alternate;transform-origin:30px 32px;animation-delay:.25s;}

.sf-flag-cloth{animation:flagWave 1.1s ease-in-out infinite;transform-origin:46px 4px;}

.sf-leg-l,.sf-leg-r{animation:legSwing 0.5s ease-in-out infinite alternate;transform-origin:30px 55px;}

.sf-leg-l{animation-delay:.25s;}

@keyframes armSwing{0%{transform:rotate(-14deg);}100%{transform:rotate(14deg);}}

@keyframes flagWave{0%,100%{transform:rotate(-6deg);}50%{transform:rotate(10deg);}}

@keyframes legSwing{0%{transform:rotate(10deg);}100%{transform:rotate(-10deg);}}

@keyframes climbStairs{
  0%{transform:translate(0,0);opacity:0;}
  6%{opacity:1;}
  18%{transform:translate(74px,-50px);}
  36%{transform:translate(148px,-100px);}
  54%{transform:translate(222px,-150px);}
  70%{transform:translate(294px,-200px);}
  86%{transform:translate(294px,-200px);opacity:1;}
  93%{transform:translate(294px,-200px);opacity:0;}
  100%{transform:translate(0,0);opacity:0;}
}

.growth-sparkles{position:absolute;left:280px;bottom:250px;width:80px;height:80px;pointer-events:none;z-index:6;}

.spk{position:absolute;font-size:15px;color:var(--yellow);opacity:0;animation:sparklePop 5.8s ease-in-out infinite;filter:drop-shadow(0 2px 4px rgba(21,23,27,.2));}

.spk-1{top:6px;left:2px;color:var(--coral);animation-delay:0s;}

.spk-2{top:-6px;left:34px;animation-delay:.12s;}

.spk-3{top:16px;left:56px;color:var(--teal);animation-delay:.22s;}

.spk-4{top:38px;left:16px;animation-delay:.3s;}

@keyframes sparklePop{
  0%,68%{opacity:0;transform:scale(.2) translateY(6px);}
  74%{opacity:1;transform:scale(1.15) translateY(-4px);}
  80%{opacity:1;transform:scale(.95) translateY(-2px);}
  90%,100%{opacity:0;transform:scale(.3) translateY(-10px);}
}

.case-grid{
  display:flex;gap:20px;overflow-x:auto;
  padding-bottom:8px;scrollbar-width:none;-ms-overflow-style:none;
  scroll-behavior:auto;
}

.testi-grid{
  display:flex;gap:18px;overflow-x:auto;padding-bottom:8px;align-items:stretch;
  scrollbar-width:none;-ms-overflow-style:none;scroll-behavior:auto;
}

.testi-grid::-webkit-scrollbar{display:none;}

.bubble,.bubble-open{flex:0 0 auto;width:300px;}

.bubble-open{
  background:transparent;border:1.5px dashed var(--teal);border-radius:20px;border-bottom-left-radius:4px;
  padding:24px;box-shadow:none;display:flex;flex-direction:column;
}

.bubble-open .open-badge{
  font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--teal);border:1px solid var(--teal);border-radius:99px;padding:4px 10px;
  display:inline-flex;align-self:flex-start;margin-bottom:14px;
}

.bubble-open b{font-size:14.5px;display:block;margin-bottom:8px;}

.bubble-open p{font-size:14px;line-height:1.6;color:#33352f;flex-grow:1;}

.bubble-open a{
  margin-top:16px;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--teal);
  border-bottom:1px solid var(--teal);align-self:flex-start;padding-bottom:2px;
}

/* ---------- RESPONSIVE ---------- */
@media (max-width:900px){
  .hero{grid-template-columns:1fr;padding-top:140px;padding-bottom:70px;gap:0;}
  .growth-stage{display:none;}
  .nav-links,.nav-right{display:none;}
  .burger{display:flex;}
  .mobile-nav-group{display:flex;}
  .services-grid{grid-template-columns:1fr 1fr;}
  .mini-stats{margin-top:40px;}
}

@media (max-width:600px){
  .wrap{padding-left:20px;padding-right:20px;}
  .hero{padding-top:120px;}
  .hero h1{font-size:clamp(32px,9vw,44px);}
  .hero p.lede{font-size:16px;}
  .services-grid{grid-template-columns:1fr;}
  .bubble,.bubble-open{width:calc(100vw - 72px);}
  .process-row{grid-template-columns:1fr;gap:30px;}
  .process-row::before{display:none;}
  .mini-stats{gap:0;margin-top:34px;flex-wrap:nowrap;justify-content:space-between;}
  .mini-stat{flex:0 0 auto;padding-right:0;margin-right:0;border-right:none;min-width:0;position:relative;}
  .mini-stat b{font-size:20px;}
  .mini-stat span{font-size:10.5px;line-height:1.25;display:block;white-space:nowrap;}
  .mini-stat b .counter{font-size:inherit;}
  .mini-divider{
    display:block;position:absolute;top:2px;bottom:2px;width:1px;
    background:rgba(21,23,27,.15);
  }
}
</style>
</Fragment>


<!-- HERO -->
<header class="hero wrap">
  <div>
    <h1 data-i18n="hero_h1">Grow <span class="hl">Faster</span> with Data-Driven<br>Digital Marketing.</h1>
    <p class="lede" data-i18n="hero_lede">Dari branding dan website hingga strategi konten dan Meta Ads, kami membantu bisnis Anda meningkatkan brand awareness, menghasilkan leads, dan meningkatkan penjualan.</p>
    <div class="hero-ctas">
      <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="hero_cta1">Mulai Proyek →</a>
      <a href="portofolio.html" class="btn-secondary" data-i18n="hero_cta2">Lihat Portofolio</a>
    </div>
    <div class="mini-stats">
      <div class="mini-stat"><b data-count="20"><span class="counter">0</span>+</b><span data-i18n="stat1">Brand Partner Aktif</span></div>
      <span class="mini-divider" id="miniDiv1"></span>
      <div class="mini-stat"><b data-count="99"><span class="counter">0</span>%</b><span data-i18n="stat2">Klien Puas</span></div>
      <span class="mini-divider" id="miniDiv2"></span>
      <div class="mini-stat"><b data-count="10"><span class="counter">0</span>M+</b><span data-i18n="stat3">Views Konten Viral</span></div>
    </div>
  </div>

  <div class="growth-stage">
    <div class="growth-scene">
      <div class="growth-floaters">
        <span class="gf gf-1">📈</span>
        <span class="gf gf-2">✦</span>
        <span class="gf gf-3">🚀</span>
        <span class="gf gf-4">✦</span>
      </div>
      <svg aria-hidden="true" focusable="false" class="growth-chart-bg" viewBox="0 0 400 320" xmlns="http://www.w3.org/2000/svg">
        <polyline points="20,300 20,20 380,20" fill="none" stroke="rgba(21,23,27,.12)" stroke-width="2"/>
        <line x1="20" y1="240" x2="380" y2="240" stroke="rgba(21,23,27,.06)" stroke-width="1"/>
        <line x1="20" y1="160" x2="380" y2="160" stroke="rgba(21,23,27,.06)" stroke-width="1"/>
        <line x1="20" y1="80" x2="380" y2="80" stroke="rgba(21,23,27,.06)" stroke-width="1"/>
      </svg>
      <div class="growth-stairs">
        <div class="stair stair-1"></div>
        <div class="stair stair-2"></div>
        <div class="stair stair-3"></div>
        <div class="stair stair-4"></div>
        <div class="stair stair-5"></div>
