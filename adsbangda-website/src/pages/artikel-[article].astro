---
// Halaman artikel dibuat OTOMATIS dari setiap file .md di src/content/blog/
// Tidak perlu bikin file HTML baru lagi -- cukup tambah file markdown baru,
// halaman "/artikel-<nama-file>.html" langsung ke-generate otomatis saat build.
import { getCollection, render } from "astro:content";
import BlogPost from "../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { article: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);

// artikel terkait: ambil sampai 3 artikel lain (bukan artikel ini sendiri)
const relatedPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 3);
---
<BlogPost
  title={post.data.title}
  description={post.data.description}
  category={post.data.category}
  date={post.data.date}
  readTime={post.data.readTime}
  path={`artikel-${post.id}.html`}
  headings={headings}
  relatedPosts={relatedPosts}
  titleEn={post.data.title_en}
  categoryEn={post.data.category_en}
  readTimeEn={post.data.readTime_en}
  bodyEn={post.data.body_en}
>
  <Content />
</BlogPost>
