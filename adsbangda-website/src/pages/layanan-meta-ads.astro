---
import Layout from "../layouts/Layout.astro";
const title = 'Adsbangda - Meta Ads Performance';
const description = 'Naikin konten organic terbaik jadi campaign ads yang terarah dan performing di Instagram & Facebook. Kami rancang funnel dari awareness sampai konvers';
---
<Layout title={title} description={description} path="layanan-meta-ads.html" portfolioCss={false}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }



<section class="service-page-hero">
  <div class="wrap">
    <div class="breadcrumb"><a href="layanan.html" data-i18n-nav="layanan">Layanan</a> / <span data-i18n="svc_name">Meta Ads Performance</span></div>
    <div class="service-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r=".6" fill="#15171B"/></svg></div>
    <h1 data-i18n="hero_h1">Meta Ads Performance</h1>
    <p class="lede" data-i18n="hero_p">Naikin konten organic terbaik jadi campaign ads yang terarah dan performing di Instagram & Facebook. Kami rancang funnel dari awareness sampai konversi, dengan targeting presisi dan optimasi berbasis data.</p>
    <div class="tag-row"><span data-i18n="tag1">Ads Strategy</span><span data-i18n="tag2">Targeting</span><span data-i18n="tag3">A/B Testing</span><span data-i18n="tag4">Lead Generation</span></div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="service-detail-grid">
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:14px;" data-i18n="cocok_h">Cocok Buat Siapa?</h2>
        <p style="font-size:15px;line-height:1.75;color:#3b3d3a;text-align:justify;" data-i18n="cocok_p">Cocok buat bisnis yang mau hasil lebih terukur dari sekadar "boost post" — fokus ke leads atau penjualan nyata, bukan cuma like.</p>
      </div>
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:16px;" data-i18n="dapat_h">Yang Kamu Dapat</h2>
        <ul class="include-list">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc1">Riset audiens &amp; strategi targeting</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc2">Pembuatan creative ads (gambar, video, copy)</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc3">Setup campaign &amp; optimasi budget harian</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc4">A/B testing buat cari kombinasi terbaik</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc5">Laporan performa &amp; rekomendasi optimasi rutin</span></li>
        </ul>
        <div class="service-cta-row">
          <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="cta_btn">Konsultasi Layanan Ini &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 style="font-size:24px;" data-i18n="other_h2">Butuh yang lain juga?</h2>
    </div>
    <div class="service-simple-grid">
      <a href="layanan-sosial-media-management.html" class="service-simple-card reveal">
        <div class="service-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><rect x="3" y="6" width="14" height="12" rx="2"/><path d="M17 10l4-2v8l-4-2"/></svg></div>
        <h3>Social Media Management</h3>
        <p data-i18n="other1_p">Produksi konten harian/mingguan — dari naskah, syuting, sampai desain feed yang konsisten ...</p>
        <div class="link-more" data-i18n="link_more">Lihat Detail &rarr;</div>
      </a><a href="layanan-content-strategy.html" class="service-simple-card reveal">
        <div class="service-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M4 19V10M12 19V5M20 19v-7"/></svg></div>
        <h3>Content Strategy</h3>
        <p data-i18n="other2_p">Riset tren, kalender konten, dan hook 3 detik pertama yang bikin orang berhenti scroll. Ka...</p>
        <div class="link-more" data-i18n="link_more">Lihat Detail &rarr;</div>
      </a><a href="layanan-kol-management.html" class="service-simple-card reveal">
        <div class="service-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6"/><circle cx="17.5" cy="9" r="2.3"/><path d="M15.5 20c0-2.8 1.6-5 3.8-5"/></svg></div>
        <h3>KOL & Influencer Management</h3>
        <p data-i18n="other3_p">Matchmaking brand dengan key opinion leader dan influencer yang suaranya emang cocok sama ...</p>
        <div class="link-more" data-i18n="link_more">Lihat Detail &rarr;</div>
      </a>
    </div>
  </div>
</section>


