---
import Layout from "../layouts/Layout.astro";
const title = 'Adsbangda - Branding & Visual Identity';
const description = 'Bangun identitas visual brand yang konsisten dan gampang dikenali — dari logo, palet warna, tipografi, sampai panduan penggunaannya. Biar brand kamu k';
---
<Layout title={title} description={description} path="layanan-branding-visual-identity.html" portfolioCss={false}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }



<section class="service-page-hero">
  <div class="wrap">
    <div class="breadcrumb"><a href="layanan.html" data-i18n-nav="layanan">Layanan</a> / <span data-i18n="svc_name">Branding & Visual Identity</span></div>
    <div class="service-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8"/></svg></div>
    <h1 data-i18n="hero_h1">Branding & Visual Identity</h1>
    <p class="lede" data-i18n="hero_p">Bangun identitas visual brand yang konsisten dan gampang dikenali — dari logo, palet warna, tipografi, sampai panduan penggunaannya. Biar brand kamu kelihatan profesional dan konsisten di semua touchpoint.</p>
    <div class="tag-row"><span data-i18n="tag1">Logo Design</span><span data-i18n="tag2">Brand Guideline</span><span data-i18n="tag3">Color & Typography</span><span data-i18n="tag4">Visual Consistency</span></div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="service-detail-grid">
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:14px;" data-i18n="cocok_h">Cocok Buat Siapa?</h2>
        <p style="font-size:15px;line-height:1.75;color:#3b3d3a;text-align:justify;" data-i18n="cocok_p">Cocok buat bisnis yang identitas visualnya masih belum konsisten (logo beda-beda, warna ganti-ganti) atau yang baru mau membangun brand dari nol.</p>
      </div>
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:16px;" data-i18n="dapat_h">Yang Kamu Dapat</h2>
        <ul class="include-list">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc1">Riset &amp; konsultasi arah visual brand</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc2">Desain/penyempurnaan logo</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc3">Penentuan palet warna &amp; tipografi brand</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc4">Brand guideline lengkap (cara pakai logo, warna, font)</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc5">Template visual dasar buat konten &amp; materi promosi</span></li>
        </ul>
        <div class="service-cta-row">
          <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="cta_btn">Konsultasi Layanan Ini &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 style="font-size:24px;" data-i18n="other_h2">Butuh yang lain juga?</h2>
    </div>
    <div class="service-simple-grid">
      <a href="layanan-sosial-media-management.html" class="service-simple-card reveal">
        <div class="service-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><rect x="3" y="6" width="14" height="12" rx="2"/><path d="M17 10l4-2v8l-4-2"/></svg></div>
        <h3>Social Media Management</h3>
        <p data-i18n="other1_p">Produksi konten harian/mingguan — dari naskah, syuting, sampai desain feed yang konsisten ...</p>
