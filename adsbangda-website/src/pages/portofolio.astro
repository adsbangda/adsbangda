// ---- render portfolio grid: one card per client ----
const portfolioGrid = document.getElementById('portfolioGrid');
const modalOverlay = document.getElementById('modalOverlay');
const modalContent = document.getElementById('modalContent');
const modalClose = document.getElementById('modalClose');

function T(v){ return (v && typeof v === 'object' && !Array.isArray(v)) ? (v[currentLang] !== undefined ? v[currentLang] : (v.id || v.en)) : v; }
function brandSlug(brand){ return brand.toLowerCase().trim().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,''); }

function openClientModal(client){
  modalContent.innerHTML = `
    <div class="modal-eyebrow">${currentLang === 'id' ? 'Portofolio' : 'Portfolio'}</div>
    <div class="modal-title">${client.brand}</div>
    <div class="modal-tags">${T(client.tags)}</div>
    ${client.projects.map(p => `
      <div class="modal-project">
        <div class="mp-thumb"><img src="${p.img}" alt="${T(p.title)} — ${client.brand}" loading="lazy"></div>
        <h4>${T(p.title)}</h4>
        <p>${T(p.desc)}</p>
        <div class="mp-meta">
          <div><b>${T(p.meta1[0])}</b>${T(p.meta1[1])}</div>
          <div><b>${T(p.meta2[0])}</b>${T(p.meta2[1])}</div>
        </div>
      </div>
    `).join('')}
  `;
  modalOverlay.classList.add('open');
  document.body.style.overflow = 'hidden';
  isAutoScrolling = false;
  if(autoRafId) cancelAnimationFrame(autoRafId);
  clearTimeout(window._autoSlideResume);
}
function closeClientModal(){
  modalOverlay.classList.remove('open');
  document.body.style.overflow = '';
  startAutoSlide();
}
modalClose.addEventListener('click', closeClientModal);
modalOverlay.addEventListener('click', (e)=>{ if(e.target === modalOverlay) closeClientModal(); });
document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape') closeClientModal(); });

const cardRefs = [];
function buildCard(client, immediate){
  const el = document.createElement('div');
  el.className = immediate ? 'case-card reveal in' : 'case-card reveal';
  el.innerHTML = `
    <div class="thumb"><img src="${client.thumb}" alt="Contoh konten ${client.brand}" loading="lazy"></div>
    <div class="case-body">
      <div class="cat">${T(client.tags)}</div>
      <h3>${client.brand}</h3>
      <p>${T(client.summary)}</p>
      <div class="view-more">${currentLang === 'id' ? 'Lihat detail proyek →' : 'View project details →'}</div>
    </div>
  `;
  el.addEventListener('click', ()=> { window.location.href = 'portofolio-' + brandSlug(client.brand) + '.html'; });
  return el;
}
// Original set
clients.forEach(client=>{
  const el = buildCard(client, true);
  portfolioGrid.appendChild(el);
  cardRefs.push({client, el});
});
const originalCardCount = cardRefs.length;
// Prepend a duplicate set BEFORE the originals too, so the track has real
// content to reveal when the user drags/swipes backward from the very first
// card -- without this, there's nothing before position 0 and the browser
// just clamps the scroll there (looks like "can't swipe left").
let prependSetCount = 0;
function addPrependCardSet(){
  const frag = document.createDocumentFragment();
  clients.forEach(client=>{
    const el = buildCard(client, true);
    frag.appendChild(el);
    cardRefs.push({client, el});
  });
  portfolioGrid.insertBefore(frag, portfolioGrid.firstChild);
  prependSetCount++;
}
addPrependCardSet();
while(portfolioGrid.scrollWidth < window.innerWidth * 2.2){
  addPrependCardSet();
}
// Duplicate set(s) appended right after, so the track can scroll forward endlessly and wrap invisibly.
// Keep adding full duplicate sets until the track is comfortably wider than the viewport,
// so ultra-wide monitors never run out of content before the wrap point.
function addDuplicateCardSet(){
  clients.forEach(client=>{
    const el = buildCard(client, true);
    portfolioGrid.appendChild(el);
    cardRefs.push({client, el});
  });
}
addDuplicateCardSet();
while(portfolioGrid.scrollWidth < window.innerWidth * 2.2){
  addDuplicateCardSet();
}

function updatePortfolioCardsLang(){
  cardRefs.forEach(({client, el})=>{
    el.querySelector('.cat').textContent = T(client.tags);
    el.querySelector('.case-body p').textContent = T(client.summary);
    el.querySelector('.view-more').textContent = currentLang === 'id' ? 'Lihat detail proyek →' : 'View project details →';
  });
}

// ---- portfolio slider controls (seamless infinite loop) ----
const sliderPrev = document.getElementById('sliderPrev');
const sliderNext = document.getElementById('sliderNext');
const sliderDots = document.getElementById('sliderDots');
const cardEls = Array.from(portfolioGrid.children);

for(let i=0;i<originalCardCount;i++){
  const dot = document.createElement('span');
  if(i === 0) dot.classList.add('active');
  dot.addEventListener('click', ()=>{
    portfolioGrid.scrollTo({left: setWidth() * prependSetCount + i * cachedCardStep, behavior:'smooth'});
    pauseAutoSlide();
  });
  sliderDots.appendChild(dot);
}
const dotEls2 = Array.from(sliderDots.children);

let cachedCardStep = 360;
function recomputeCardStep(){
  const card = cardEls[0];
  const style = getComputedStyle(portfolioGrid);
  const gap = parseFloat(style.columnGap || style.gap || 20);
  cachedCardStep = card.getBoundingClientRect().width + gap;
}
recomputeCardStep();

function setWidth(){ return cachedCardStep * originalCardCount; }

// Start the visible scroll position right after the prepended set(s), so the
// page loads showing the "real" first card -- same as before -- but there's
// now real duplicate content sitting behind it to scroll into when swiping left.
portfolioGrid.scrollLeft = setWidth() * prependSetCount;

function wrapCheck(){
  const sw = setWidth();
  const maxScroll = portfolioGrid.scrollWidth - portfolioGrid.clientWidth;
  // Only correct when actually near either end of the whole track (within
  // half a set's width of the edge) -- everything in between is free to
  // scroll through normally without being yanked back mid-swipe.
  if(portfolioGrid.scrollLeft < sw * 0.5){
    portfolioGrid.scrollLeft += sw;
  } else if(portfolioGrid.scrollLeft > maxScroll - sw * 0.5){
    portfolioGrid.scrollLeft -= sw;
  }
}
function updateSliderState(){
  const idx = Math.round(portfolioGrid.scrollLeft / cachedCardStep) % originalCardCount;
  dotEls2.forEach((d,i)=> d.classList.toggle('active', i === idx));
}
let scrollDebounce = null;
portfolioGrid.addEventListener('scroll', ()=>{
  updateSliderState();
  clearTimeout(scrollDebounce);
  scrollDebounce = setTimeout(wrapCheck, 150);
});
sliderPrev.addEventListener('click', ()=>{
  portfolioGrid.scrollBy({left: -cachedCardStep, behavior:'smooth'});
  pauseAutoSlide();
});
sliderNext.addEventListener('click', ()=>{
  portfolioGrid.scrollBy({left: cachedCardStep, behavior:'smooth'});
  pauseAutoSlide();
});
window.addEventListener('resize', ()=>{ recomputeCardStep(); updateSliderState(); });
updateSliderState();

// ---- auto-play slider ----
let isAutoScrolling = false;
let autoSlideTimer = null;

function autoSlideTick(){
  portfolioGrid.scrollBy({left: cachedCardStep, behavior:'smooth'});
}
function startAutoSlide(){
  if(reduceMotion) return;
  if(isAutoScrolling) return;
  isAutoScrolling = true;
  autoSlideTimer = setInterval(autoSlideTick, 2800);
}
function pauseAutoSlide(){
  isAutoScrolling = false;
  clearInterval(autoSlideTimer);
  clearTimeout(window._autoSlideResume);
  window._autoSlideResume = setTimeout(startAutoSlide, 4500);
}
const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
if(supportsHover){
  portfolioGrid.addEventListener('mouseenter', ()=>{ isAutoScrolling = false; clearInterval(autoSlideTimer); });
  portfolioGrid.addEventListener('mouseleave', startAutoSlide);
}
// Touch devices (iPad, phones): pause the instant a finger touches the slider
// so it doesn't fight the user's own swipe, and resume right when the finger
// lifts -- no fixed delay, matches the hover behavior above.
portfolioGrid.addEventListener('touchstart', ()=>{ isAutoScrolling = false; clearInterval(autoSlideTimer); clearTimeout(window._autoSlideResume); }, {passive:true});
portfolioGrid.addEventListener('touchend', startAutoSlide, {passive:true});
portfolioGrid.addEventListener('touchcancel', startAutoSlide, {passive:true});
sliderDots.addEventListener('click', pauseAutoSlide);

// Only run the auto-slide while the portfolio section is actually visible on screen,
// so it always starts cleanly from the first card instead of already mid-scroll
// by the time the user scrolls down to it.
const portfolioSection = document.getElementById('portofolio');
const portfolioVisibility = new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      startAutoSlide();
    } else {
      isAutoScrolling = false;
      clearInterval(autoSlideTimer);
      clearTimeout(window._autoSlideResume);
    }
  });
}, {threshold: 0.15});
portfolioVisibility.observe(portfolioSection);



// ---- page-specific translations (Portofolio) ----
const translations = {
  hero_h1: {id:'Brand yang udah kita garap bareng', en:'Brands we\'ve worked on together'},
  hero_p: {id:'Sebagian portofolio dari klien yang kita pegang &mdash; geser buat lihat semua, klik kartunya buat lihat detail.', en:'A selection of portfolio pieces from clients we\'ve worked with &mdash; scroll to see them all, click a card to see the details.'},
  cta_h2: {id:'Mau Jadi Portofolio Berikutnya?', en:'Want to Be Our Next Portfolio Piece?'},
  cta_p: {id:'Ceritain bisnis kamu, kita bantu rancang strategi digital yang paling pas.', en:'Tell us about your business, and we\'ll help design the digital strategy that fits best.'},
  cta_btn: {id:'Mulai Proyek &rarr;', en:'Start a Project &rarr;'},
};

window.extraLangHook = function(lang){
  cardRefs.forEach(({client, el})=>{
    const catEl = el.querySelector('.cat');
    const pEl = el.querySelector('.case-body p');
    const moreEl = el.querySelector('.view-more');
    if(catEl) catEl.textContent = T(client.tags);
    if(pEl) pEl.textContent = T(client.summary);
    if(moreEl) moreEl.textContent = lang === 'id' ? 'Lihat detail proyek →' : 'View project details →';
  });
};
</script>
</Fragment>
</Layout>
