---
import Layout from "../layouts/Layout.astro";
const title = 'Portofolio Klien Kami | Adsbangda';
const description = 'Lihat portofolio dan hasil kerja adsbangda bersama berbagai klien di bidang F&B, properti, edukasi, dan lainnya.';
---
<Layout title={title} description={description} path="portofolio.html" portfolioCss={false}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }
<Fragment slot="head-style">
<style>
/* kontak */
.kontak-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:start;}

.kontak-card{background:var(--white);border:1px solid rgba(21,23,27,.09);border-radius:20px;padding:28px;margin-bottom:16px;}
</style>
</Fragment>



<section class="page-hero">
  <div class="wrap">
    <h1 data-i18n="hero_h1">Brand yang udah kita garap bareng</h1>
    <p data-i18n="hero_p">Sebagian portofolio dari klien yang kita pegang &mdash; geser buat lihat semua, klik kartunya buat lihat detail.</p>
  </div>
</section>

<section class="section section-dark" id="portofolio" style="padding-top:56px;">
  <div class="wrap">
    <div class="slider-controls">
      <button class="slider-btn" id="sliderPrev" aria-label="Sebelumnya">
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="slider-btn" id="sliderNext" aria-label="Selanjutnya">
        <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
    <div class="case-grid" id="portfolioGrid"></div>
    <div class="slider-dots" id="sliderDots"></div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2 data-i18n="cta_h2">Mau Jadi Portofolio Berikutnya?</h2>
    <p data-i18n="cta_p">Ceritain bisnis kamu, kita bantu rancang strategi digital yang paling pas.</p>
    <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="cta_btn">Mulai Proyek &rarr;</a>
  </div>
</section>

<div class="modal-overlay" id="modalOverlay">
  <div class="modal-box">
    <button class="modal-close" id="modalClose" aria-label="Tutup">&times;</button>
    <div id="modalContent"></div>
  </div>
</div>


