---
import Layout from "../layouts/Layout.astro";
const title = 'Layanan Branding, Website & Digital Marketing | Adsbangda';
const description = '8 layanan Adsbangda: Branding, Website & Landing Page, Social Media Management, Meta Ads, KOL Management, Creative Design, Content Strategy, dan Digital Growth Consulting.';

const SITE = "https://www.adsbangda.com";
const services = [
  ["Social Media Management", "layanan-sosial-media-management.html"],
  ["Content Strategy", "layanan-content-strategy.html"],
  ["Meta Ads Performance", "layanan-meta-ads.html"],
  ["KOL & Influencer Management", "layanan-kol-management.html"],
  ["Branding & Visual Identity", "layanan-branding-visual-identity.html"],
  ["Website & Landing Page", "layanan-website-landing-page.html"],
  ["Creative Design", "layanan-creative-design.html"],
  ["Digital Growth Consulting", "layanan-digital-growth-consulting.html"],
];

const itemListSchema = {
  "@type": "ItemList",
  "@id": `${SITE}/layanan.html#itemlist`,
  name: "Layanan Adsbangda",
  itemListElement: services.map(([name, url], i) => ({
    "@type": "ListItem",
    position: i + 1,
    name,
    url: `${SITE}/${url}`,
  })),
};
---
<Layout title={title} description={description} path="layanan.html" portfolioCss={false} extraSchema={itemListSchema}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }



