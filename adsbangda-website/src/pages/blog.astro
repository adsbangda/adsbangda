---
// Halaman /blog.html -- daftar artikel di-generate OTOMATIS dari
// semua file markdown di src/content/blog/. Tambah artikel baru = otomatis
// muncul di sini, urut dari yang terbaru, tanpa perlu edit halaman ini.
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
// urutkan terbaru dulu berdasarkan field date -- karena formatnya teks bebas
// (mis. "19 Juli 2026"), urutan file di-reverse saja (artikel baru = ditambah belakangan).
posts.reverse();
---
<Layout
  title="Blog Branding & Digital Marketing | Adsbangda"
  description="Insight, tips, dan strategi praktis dari tim Adsbangda -- branding, website, social media, Meta Ads, sampai digital marketing."
  path="blog.html"
>
<section class="page-hero">
  <div class="wrap">
    <h1 data-i18n-nav="blog_hero_h">Insight seputar social media &amp; digital marketing</h1>
    <p data-i18n-nav="blog_hero_p">Tips, strategi, dan pembahasan praktis yang bisa langsung kamu terapkan buat bisnis kamu.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="blog-grid">
      {posts.map((post) => {
        const hasEn = !!post.data.body_en;
        const slugKey = post.id.replace(/[^a-zA-Z0-9]/g, "_");
        return (
          <a href={`/artikel-${post.id}.html`} class="blog-card reveal" style="text-decoration:none;color:inherit;">
            <div class="blog-thumb" style={`background:${post.data.thumbGradient};`}>
              <span style={`color:${post.data.thumbTextColor};`} data-i18n={hasEn ? `${slugKey}_lthumb` : undefined}>{post.data.thumbText}</span>
            </div>
            <div class="blog-body">
              <div class="blog-cat" data-i18n={hasEn ? `${slugKey}_lcat` : undefined}>{post.data.category}</div>
              <h3 data-i18n={hasEn ? `${slugKey}_ltitle` : undefined}>{post.data.title}</h3>
              <p data-i18n={hasEn ? `${slugKey}_ldesc` : undefined}>{post.data.description}</p>
              <div class="blog-meta">
                <span>{post.data.date} &middot; {post.data.readTime}</span>
                <span class="read-more" data-i18n-nav="baca">Baca &rarr;</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<Fragment slot="page-scripts">
  <script is:inline define:vars={{
    entries: posts.filter((p) => p.data.body_en).map((p) => {
      const slugKey = p.id.replace(/[^a-zA-Z0-9]/g, "_");
      return {
        titleKey: `${slugKey}_ltitle`, title: p.data.title, titleEn: p.data.title_en,
        descKey: `${slugKey}_ldesc`, desc: p.data.description, descEn: p.data.description_en,
        catKey: `${slugKey}_lcat`, cat: p.data.category, catEn: p.data.category_en,
        thumbKey: `${slugKey}_lthumb`, thumb: p.data.thumbText, thumbEn: p.data.thumbText_en,
      };
    }),
  }}>
    window.translations = window.translations || {};
    entries.forEach(function (e) {
      window.translations[e.titleKey] = { id: e.title, en: e.titleEn };
      window.translations[e.descKey] = { id: e.desc, en: e.descEn };
      window.translations[e.catKey] = { id: e.cat, en: e.catEn };
      window.translations[e.thumbKey] = { id: e.thumb, en: e.thumbEn };
    });
    var translations = window.translations;
  </script>
</Fragment>
</Layout>
