  inc5: {id:'Laporan hasil (views, engagement, konversi)', en:'Results reports (views, engagement, conversions)'},
  cta_btn: {id:'Konsultasi Layanan Ini &rarr;', en:'Consult About This Service &rarr;'},
  other_h2: {id:'Butuh yang lain juga?', en:'Need Something Else Too?'},
  other1_p: {id:'Produksi konten harian/mingguan — dari naskah, syuting, sampai desain feed yang konsisten ...', en:'Daily/weekly content production — from scripting and filming to consistent feed design ...'},
  other2_p: {id:'Riset tren, kalender konten, dan hook 3 detik pertama yang bikin orang berhenti scroll. Ka...', en:'Trend research, content calendars, and 3-second hooks that stop people from scrolling. We...'},
