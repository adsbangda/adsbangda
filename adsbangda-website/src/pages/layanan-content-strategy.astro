---
import Layout from "../layouts/Layout.astro";
const title = 'Adsbangda - Content Strategy';
const description = 'Riset tren, kalender konten, dan hook 3 detik pertama yang bikin orang berhenti scroll. Kami bantu bisnis kamu punya arah konten yang jelas — bukan cu';
---
<Layout title={title} description={description} path="layanan-content-strategy.html" portfolioCss={false}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }



<section class="service-page-hero">
  <div class="wrap">
    <div class="breadcrumb"><a href="layanan.html" data-i18n-nav="layanan">Layanan</a> / <span data-i18n="svc_name">Content Strategy</span></div>
    <div class="service-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M4 19V10M12 19V5M20 19v-7"/></svg></div>
    <h1 data-i18n="hero_h1">Content Strategy</h1>
    <p class="lede" data-i18n="hero_p">Riset tren, kalender konten, dan hook 3 detik pertama yang bikin orang berhenti scroll. Kami bantu bisnis kamu punya arah konten yang jelas — bukan cuma posting random tanpa tujuan.</p>
    <div class="tag-row"><span data-i18n="tag1">Market Research</span><span data-i18n="tag2">Content Pillar</span><span data-i18n="tag3">Trend Analysis</span><span data-i18n="tag4">Editorial Calendar</span></div>
