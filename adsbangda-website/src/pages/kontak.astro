---
import Layout from "../layouts/Layout.astro";
const title = 'Adsbangda - Kontak';
const description = 'Hubungi adsbangda untuk konsultasi gratis kebutuhan social media management, Meta Ads, dan digital marketing bisnis kamu. Respon cepat lewat WhatsApp.';
---
<Layout title={title} description={description} path="kontak.html" portfolioCss={false}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }
<Fragment slot="head-style">
<style>
.wa-numbers{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:2px;}

.kontak-card .wa-numbers .wa-cta{margin-top:0;}

/* kontak form */
.kontak-form-section{padding-top:0;}

.kontak-form-card{
  background:var(--white);border:1px solid rgba(21,23,27,.09);border-radius:20px;
  padding:36px;
}

.kontak-form-card .form-head{margin-bottom:26px;}

.kontak-form-card .form-head h2{font-size:24px;margin-bottom:8px;}

.kontak-form-card .form-head p{font-size:14.5px;color:#4d4f4a;line-height:1.6;}

.kontak-form{display:grid;grid-template-columns:1fr 1fr;gap:18px;}

.kontak-form .field-full{grid-column:1/-1;}

.kontak-form label{
  display:block;font-family:'IBM Plex Mono',monospace;font-size:11.5px;
  text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-bottom:8px;
}

.kontak-form input,.kontak-form select,.kontak-form textarea{
  width:100%;background:var(--paper);border:1.5px solid rgba(21,23,27,.12);
  border-radius:12px;padding:13px 15px;font-family:'Instrument Sans',sans-serif;
  font-size:14.5px;color:var(--ink);transition:border-color .18s ease,background .18s ease;
}

.kontak-form input:focus,.kontak-form select:focus,.kontak-form textarea:focus{
  outline:none;border-color:var(--coral);background:var(--white);
}

.kontak-form textarea{resize:vertical;min-height:120px;}

.kontak-form .form-submit-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap;}

.kontak-form button[type="submit"]{
  background:var(--ink);color:var(--paper);padding:15px 30px;border-radius:100px;
  font-weight:700;font-size:15px;border:1px solid var(--ink);cursor:pointer;
  transition:transform .18s ease,background .18s ease;
}

.kontak-form button[type="submit"]:hover{background:var(--coral);border-color:var(--coral);transform:translateY(-2px);}

.kontak-form button[type="submit"]:disabled{opacity:.6;cursor:not-allowed;transform:none;}

.form-status{font-size:13.5px;font-weight:600;display:none;}

.form-status.show{display:block;}

.form-status.ok{color:var(--teal);}

.form-status.err{color:var(--coral);}

@media (max-width:640px){
  .kontak-form{grid-template-columns:1fr;}
  .kontak-form-card{padding:26px 22px;}
}
</style>
</Fragment>



<section class="page-hero">
  <div class="wrap">
    <h1 data-i18n="hero_h1">Yuk, Ceritain Kebutuhan Brand Kamu!</h1>
    <p data-i18n="hero_p">Nggak perlu bingung harus mulai dari mana. Isi salah satu channel di bawah, kita balikin ide dan strategi awal dalam 2 hari kerja.</p>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="kontak-grid">
      <div style="display:flex;flex-direction:column;justify-content:space-between;gap:16px;height:100%;">
        <div class="kontak-card reveal">
          <div class="k-icon"><svg width="20" height="20" viewBox="0 0 32 32" fill="#15171B"><path d="M16.004 3C9.086 3 3.5 8.58 3.5 15.5c0 2.36.65 4.57 1.78 6.46L3 29l7.24-2.25a12.4 12.4 0 0 0 5.76 1.42h.01c6.92 0 12.5-5.58 12.5-12.5S22.93 3 16.004 3zm0 22.86h-.01a10.3 10.3 0 0 1-5.26-1.44l-.38-.22-3.9 1.21 1.24-3.8-.25-.39a10.32 10.32 0 0 1-1.58-5.5c0-5.7 4.64-10.34 10.35-10.34 2.76 0 5.36 1.08 7.32 3.03a10.27 10.27 0 0 1 3.03 7.31c0 5.71-4.64 10.34-10.36 10.34zm5.68-7.74c-.31-.16-1.85-.91-2.14-1.02-.29-.1-.5-.16-.71.16-.21.31-.81 1.02-.99 1.23-.18.21-.37.23-.68.08-.31-.16-1.31-.48-2.49-1.54-.92-.82-1.54-1.83-1.72-2.14-.18-.31-.02-.48.14-.63.14-.14.31-.37.47-.55.16-.19.21-.31.31-.52.1-.21.05-.39-.03-.55-.08-.16-.71-1.71-.97-2.34-.26-.62-.52-.53-.71-.54h-.6c-.21 0-.55.08-.84.39-.29.31-1.1 1.08-1.1 2.63s1.13 3.05 1.29 3.26c.16.21 2.22 3.39 5.38 4.75.75.32 1.34.52 1.8.66.76.24 1.44.21 1.99.13.61-.09 1.85-.75 2.11-1.48.26-.73.26-1.36.18-1.48-.08-.13-.29-.21-.6-.36z"/></svg></div>
          <h3>WhatsApp</h3>
          <p data-i18n="wa_p">Cara tercepat buat konsultasi langsung. Rata-rata dibalas dalam hitungan menit di jam kerja.</p>
          <div class="wa-numbers">
            <a href="#" target="_blank" rel="noopener" class="link-cta wa-cta" data-wa-phone="6282289348724">+62 822 8934 8724 &rarr;</a>
            <a href="#" target="_blank" rel="noopener" class="link-cta wa-cta" data-wa-phone="6281282262002">+62 812 8226 2002 &rarr;</a>
            <a href="#" target="_blank" rel="noopener" class="link-cta wa-cta" data-wa-phone="6285713644514">+62 857 1364 4514 &rarr;</a>
          </div>
        </div>
        <div class="kontak-card reveal">
          <div class="k-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M4 4h16v16H4z"/><path d="M4 6l8 7 8-7"/></svg></div>
          <h3>Email</h3>
          <p data-i18n="email_p">Cocok buat kirim brief lengkap, proposal, atau dokumen pendukung lainnya.</p>
          <a href="mailto:info@adsbangda.com" class="link-cta">info@adsbangda.com &rarr;</a>
        </div>
        <div class="kontak-card reveal" style="margin-bottom:0;">
          <div class="k-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M12 21s-7-5-7-11a7 7 0 0114 0c0 6-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></div>
          <h3 data-i18n="lokasi_h">Lokasi</h3>
          <p data-i18n="lokasi_p">Berbasis di Jakarta, tapi kami kerja bareng klien dari berbagai kota di Indonesia secara remote.</p>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;height:100%;">
        <div class="section-head reveal" style="margin-bottom:24px;">
          <h2 style="font-size:26px;" data-i18n="before_h2">Sebelum kamu hubungi kami</h2>
        </div>
        <div style="display:flex;flex-direction:column;flex:1;justify-content:space-between;">
          <div class="faq-item reveal">
            <h4 data-i18n="faq1_h">Berapa lama proses balasan setelah saya hubungi?</h4>
            <p data-i18n="faq1_p">Biasanya kami balas dalam 1x24 jam kerja, seringnya lebih cepat lewat WhatsApp. Setelah itu kami jadwalkan online meeting buat kenalan lebih jauh soal bisnis dan kebutuhan kamu.</p>
          </div>
          <div class="faq-item reveal">
            <h4 data-i18n="faq2_h">Apakah ada minimal durasi kerja sama?</h4>
            <p data-i18n="faq2_p">Tergantung layanan yang diambil. Untuk social media management dan Meta Ads, kami sarankan minimal 3 bulan biar strategi punya waktu cukup buat menunjukkan hasil yang terukur.</p>
          </div>
          <div class="faq-item reveal">
            <h4 data-i18n="faq3_h">Apakah bisa kerja sama untuk bisnis di luar Jakarta?</h4>
            <p data-i18n="faq3_p">Bisa banget. Sebagian besar proses kerja kami memang dilakukan remote/online, jadi lokasi bisnis kamu nggak jadi masalah.</p>
          </div>
          <div class="faq-item reveal">
            <h4 data-i18n="faq4_h">Bagaimana cara mengukur hasil kerja sama kita?</h4>
            <p data-i18n="faq4_p">Setiap campaign kami sertakan laporan performa berkala (mingguan/bulanan tergantung layanan), lengkap dengan insight dan rekomendasi optimasi ke depannya.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section kontak-form-section">
  <div class="wrap">
    <div class="kontak-form-card reveal">
      <div class="form-head">
        <h2 data-i18n="form_h2">Ceritain kebutuhan kamu lewat form</h2>
        <p data-i18n="form_p">Isi form di bawah, pesan kamu langsung masuk ke email kami dan akan dibalas dalam 1x24 jam kerja.</p>
      </div>
      <form class="kontak-form" id="kontakForm">
        <input type="hidden" name="access_key" value="b0d3d624-3ecc-4794-ba6c-ce8da7d0dc8a">
        <input type="hidden" name="subject" id="formSubject" value="Lead Baru dari Form Kontak Website Adsbangda">
        <input type="hidden" name="from_name" value="Website Adsbangda">
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

        <div>
          <label for="nama" data-i18n="label_nama">Nama Lengkap</label>
          <input type="text" id="nama" name="Nama" required placeholder="Nama kamu" data-i18n-placeholder="ph_nama">
        </div>
        <div>
          <label for="email" data-i18n="label_email">Email</label>
          <input type="email" id="email" name="Email" required placeholder="nama@email.com">
        </div>
        <div>
          <label for="wa" data-i18n="label_wa">No. WhatsApp</label>
          <input type="tel" id="wa" name="WhatsApp" required placeholder="08xxxxxxxxxx">
        </div>
        <div>
          <label for="layanan" data-i18n="label_layanan">Layanan yang Diminati</label>
          <select id="layanan" name="Layanan">
            <option>Social Media Management</option>
            <option>Content Strategy</option>
            <option>Meta Ads Performance</option>
            <option>KOL &amp; Influencer Management</option>
            <option>Branding &amp; Visual Identity</option>
            <option>Website &amp; Landing Page</option>
            <option>Creative Design</option>
            <option>Digital Growth Consulting</option>
            <option data-i18n="opt_belum_yakin">Belum Yakin / Konsultasi Dulu</option>
          </select>
        </div>
        <div class="field-full">
          <label for="pesan" data-i18n="label_pesan">Ceritakan Kebutuhan Bisnis Kamu</label>
          <textarea id="pesan" name="Pesan" required placeholder="Contoh: saya punya bisnis kopi, mau naikin awareness dan penjualan lewat Instagram..." data-i18n-placeholder="ph_pesan"></textarea>
        </div>
        <div class="field-full form-submit-row">
          <button type="submit" data-i18n="btn_kirim">Kirim Pesan &rarr;</button>
          <span class="form-status" id="formStatus"></span>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2 data-i18n="cta_h2">Masih Ada yang Ingin Ditanyakan?</h2>
    <p data-i18n="cta_p">Nggak usah ragu, chat kami langsung — biasanya dibalas dalam hitungan menit di jam kerja.</p>
    <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="cta_btn">Chat Kami Sekarang &rarr;</a>
  </div>
</section>


<Fragment slot="page-scripts">
<script is:inline>

// kontak form submit (Web3Forms)
const kontakForm = document.getElementById('kontakForm');
if(kontakForm){
  const statusEl = document.getElementById('formStatus');
  kontakForm.addEventListener('submit', async function(e){
    e.preventDefault();
    const btn = kontakForm.querySelector('button[type="submit"]');
    const accessKey = kontakForm.querySelector('input[name="access_key"]').value;

    if(!accessKey || accessKey === 'GANTI_DENGAN_ACCESS_KEY_WEB3FORMS_ANDA'){
      statusEl.textContent = 'Form belum aktif — access key belum dipasang.';
      statusEl.className = 'form-status show err';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Mengirim...';
    statusEl.className = 'form-status';

    // subjek dinamis biar email lebih personal & gak keliatan generik/spammy
    const namaVal = kontakForm.querySelector('#nama').value.trim();
    const layananVal = kontakForm.querySelector('#layanan').value;
    document.getElementById('formSubject').value = `Lead Baru: ${namaVal} tertarik ${layananVal} - Adsbangda`;

    try{
      const formData = new FormData(kontakForm);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: formData
      });
      const result = await res.json();

      if(result.success){
        statusEl.textContent = 'Terkirim! Kami akan balas ke email/WhatsApp kamu secepatnya.';
        statusEl.className = 'form-status show ok';
        kontakForm.reset();
      } else {
        statusEl.textContent = 'Gagal mengirim, coba lagi atau hubungi lewat WhatsApp.';
        statusEl.className = 'form-status show err';
      }
    } catch(err){
      statusEl.textContent = 'Gagal mengirim, coba lagi atau hubungi lewat WhatsApp.';
      statusEl.className = 'form-status show err';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Kirim Pesan \u2192';
    }
  });
}


