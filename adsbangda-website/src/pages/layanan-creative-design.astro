  svc_name: {id:'Creative Design', en:'Creative Design'},
  hero_h1: {id:'Creative Design', en:'Creative Design'},
  hero_p: {id:'Desain grafis buat segala kebutuhan promosi bisnis kamu — dari materi sosial media, banner, brosur, sampai aset iklan. Konsisten sama identitas brand, tetap fresh dan eye-catching.', en:'Graphic design for all your business promotion needs — from social media assets, banners, and brochures to ad creatives. Consistent with your brand identity, while staying fresh and eye-catching.'},
  tag1: {id:'Graphic Design', en:'Graphic Design'},
  tag2: {id:'Ad Creative', en:'Ad Creative'},
  tag3: {id:'Marketing Materials', en:'Marketing Materials'},
