---
import Layout from "../../layouts/Layout.astro";
const title = 'Umroh Rekivatour Portfolio | Adsbangda';
const description = 'Umroh Rekivatour portfolio: social media & ads strategy for a fast-growing Umrah brand, with viral content reaching 5 million views.';
---
<Layout title={title} description={description} path="en/portofolio-umroh-rekivatour.html" lang="id" lang="en" hreflangId="portofolio-umroh-rekivatour.html" portfolioCss={true} ogImageAlt="Umroh Rekivatour portfolio by Adsbangda" ogImage="assets/img/img-js-f4db9360c071.webp" ogImageWidth={700} ogImageHeight={481}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }
<Fragment slot="head-style">
<style>
.cd-summary{font-size:16px;line-height:1.75;color:#3b3d3a;margin:28px 0 50px;text-align:justify;}

.project-block .mp-thumb img{width:100%;display:block;}

/* ---- case study: tools & software ---- */
.tools-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:40px 32px;margin-top:0;}

.tools-icon-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px 10px;}

.tool-item{display:flex;flex-direction:column;align-items:flex-start;gap:8px;width:100%;text-align:left;min-width:0;}
</style>
</Fragment>



<section class="page-hero">
  <div class="wrap">
    <a href="portofolio.html" class="back-link reveal" data-i18n="back_link" style="margin-bottom:22px;display:inline-flex;">&larr; Back to Portfolio</a>
    <h1>Umroh Rekivatour</h1>
    <p data-i18n="hero_h2" style="font-size:20px;font-weight:700;margin-top:18px;line-height:1.5;">Building a Professional and Consistent Digital Presence for Umroh Rekivatour</p>
    <p class="cd-summary" data-i18n="hero_lede1" style="margin:20px 0 0;">Adsbangda helped Umroh Rekivatour grow its digital presence through an integrated strategy — from social media management and digital ad campaigns to the development of content and branding materials.</p>
    <p class="cd-summary" data-i18n="hero_lede2" style="margin:14px 0 0;">Throughout the collaboration, we focused on strengthening brand credibility, expanding audience reach, and building a consistent digital marketing foundation to support Umroh Rekivatour's business growth.</p>

    <div class="hero-meta reveal">
      <div class="hero-meta-item">
        <div class="overview-icon" style="background:rgba(244,228,9,.25);">
          <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 3.5l8 4.3-8 4.3-8-4.3 8-4.3z" stroke="#8a7c00" stroke-width="1.8" stroke-linejoin="round"/><path d="M4 12.2l8 4.3 8-4.3" stroke="#8a7c00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 16.5l8 4.3 8-4.3" stroke="#8a7c00" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="ov-text">
          <span data-i18n="ov_k3">Services</span>
          <b data-i18n="ov_v3">Social Media Management, Meta Ads, Website Development, Company Profile Design</b>
        </div>
      </div>
      <div class="hero-meta-item">
        <div class="overview-icon" style="background:rgba(255,74,61,.12);">
          <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3.5" y="3.5" width="7" height="7" rx="1.6" stroke="#FF4A3D" stroke-width="1.8"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.6" stroke="#FF4A3D" stroke-width="1.8"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.6" stroke="#FF4A3D" stroke-width="1.8"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.6" stroke="#FF4A3D" stroke-width="1.8"/></svg>
        </div>
        <div class="ov-text">
          <span data-i18n="ov_k4">Platform</span>
          <b data-i18n="ov_v4">Instagram, Tiktok, Facebook, X, Threads</b>
        </div>
      </div>
      <div class="hero-meta-item">
        <div class="overview-icon" style="background:rgba(27,75,67,.12);">
          <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M20.5 13.2L13 20.7a1.6 1.6 0 0 1-2.3 0l-7.2-7.2V4.3h9.2l7.2 7.2a1.6 1.6 0 0 1 .6 1.7z" stroke="#1B4B43" stroke-width="1.8" stroke-linejoin="round"/><circle cx="8.3" cy="8.3" r="1.4" fill="#1B4B43"/></svg>
        </div>
        <div class="ov-text">
          <span data-i18n="ov_k5">Category</span>
          <b data-i18n="ov_v5">Digital Marketing, Website Development &amp; Branding</b>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint" style="padding-top:80px;padding-bottom:80px;">
  <div class="wrap">
    <div class="cd-wrap">
      <div class="section-head reveal" style="margin-bottom:24px;">
        <h2 data-i18n="about_label">About The Project</h2>
      </div>
      <p class="cd-summary reveal" data-i18n="about_p1" style="margin:0 0 20px;">Umroh Rekivatour is a business that trusted Adsbangda as its creative partner to grow its digital presence.</p>
      <p class="cd-summary reveal" data-i18n="about_p2" style="margin:0 0 20px;">To strengthen its digital presence, Adsbangda was trusted as the creative partner handling its digital marketing needs end-to-end — from content production and campaign management, to developing the company's branding materials.</p>
      <p class="cd-summary reveal" data-i18n="about_p3" style="margin:0;">This approach helped Umroh Rekivatour build a professional image while improving communication consistency across its digital platforms.</p>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="cd-wrap">
      <p class="cd-summary reveal" data-i18n="summary">Social media &amp; ads strategy for a rapidly growing Umrah brand, with viral content reaching 5 million views.</p>
            <div class="project-block reveal">
        <h3 data-i18n="p1_h2">Social Media Content &amp; Meta Ads</h3>
        <div class="mp-thumb"><img role="button" tabindex="0" src="assets/img/img-js-b2b14ae0eb17.jpg" alt="Sosial Media Content &amp; Meta Ads — Umroh Rekivatour" loading="lazy"></div>
        <p data-i18n="p1_desc">Managing social media &amp; ads strategy for an Umrah brand with the goal of becoming Indonesia's number one provider. Viral content reaching 5 million views and generating hundreds of prospective pilgrims.</p>
        <div class="highlight-grid">
          <div class="highlight-chip"><div class="hc-icon"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12l4-4 3 3 5-6"/><path d="M11 5h3v3"/></svg></div><span data-i18n="p1_hl1">5M views viral content</span></div>
          <div class="highlight-chip"><div class="hc-icon"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12l4-4 3 3 5-6"/><path d="M11 5h3v3"/></svg></div><span data-i18n="p1_hl2">100+ prospective clients</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint" style="padding:90px 0;">
  <div class="wrap">
    <div class="section-head reveal" style="margin-bottom:28px;">
      <h2 data-i18n="wf_label">Project Workflow</h2>
      <p data-i18n="wf_desc">We apply a structured workflow to make sure every digital marketing activity runs effectively and delivers consistent output.</p>
    </div>
    <div class="wf-track reveal">
      <svg aria-hidden="true" focusable="false" class="wf-connector" viewBox="0 0 1200 320" fill="none" preserveAspectRatio="none">
        <path d="M70,35 L600,35 L1130,35 C1200,35 1200,160 1130,160 L600,160 L70,160 C0,160 0,285 70,285 L600,285 L1130,285" stroke="rgba(21,23,27,.4)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="2 11" vector-effect="non-scaling-stroke"/>
      </svg>
      <div class="wf-grid">
        <div class="wf-node"><span class="num">01</span><h3 data-i18n="wf_1">Discovery</h3></div>
        <div class="wf-node"><span class="num">02</span><h3 data-i18n="wf_2">Research</h3></div>
        <div class="wf-node"><span class="num">03</span><h3 data-i18n="wf_3">Content Planning</h3></div>
        <div class="wf-node"><span class="num">04</span><h3 data-i18n="wf_4">Design</h3></div>
        <div class="wf-node"><span class="num">05</span><h3 data-i18n="wf_5">Campaign Setup</h3></div>
        <div class="wf-node"><span class="num">06</span><h3 data-i18n="wf_6">Publishing</h3></div>
        <div class="wf-node"><span class="num">07</span><h3 data-i18n="wf_7">Monitoring</h3></div>
        <div class="wf-node"><span class="num">08</span><h3 data-i18n="wf_8">Optimization</h3></div>
        <div class="wf-node"><span class="num">09</span><h3 data-i18n="wf_9">Reporting</h3></div>
      </div>
    </div>
  </div>
</section>

<section class="section" style="padding:90px 0;">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 data-i18n="tools_label">Tools &amp; Software</h2>
      <p data-i18n="tools_desc">For the Umroh Rekivatour project, we use a range of professional software to support content production, campaign management, design, and AI-assisted workflows end-to-end.</p>
    </div>
    <div class="tools-grid reveal">
      <div class="tools-cat">
        <h3 data-i18n="tools_cat1">Creative &amp; Design</h3>
        <div class="tools-icon-row">
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-24ae85c4ad59.png" alt="Adobe Photoshop" loading="lazy"></div><span>Photoshop</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-31d06b608bbc.png" alt="Adobe Illustrator" loading="lazy"></div><span>Illustrator</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-c8b74368a17e.png" alt="Adobe Premiere Pro" loading="lazy"></div><span>Premiere Pro</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-4e3ff4c32574.png" alt="Adobe After Effects" loading="lazy"></div><span>After Effects</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-3d6909954fce.png" alt="CapCut" loading="lazy"></div><span>CapCut</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-f2725ecd67be.png" alt="Figma" loading="lazy"></div><span>Figma</span></div>
        </div>
      </div>
      <div class="tools-cat">
        <h3 data-i18n="tools_cat2">Website Development</h3>
        <div class="tools-icon-row">
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-b36714c19c08.png" alt="Hostinger" loading="lazy"></div><span>Hostinger</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-aeee84293d93.png" alt="WordPress" loading="lazy"></div><span>WordPress</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-8fd515b16c19.png" alt="Elementor" loading="lazy"></div><span>Elementor</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-eca488a6cc75.png" alt="Google Analytics 4" loading="lazy"></div><span>Analytics 4</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-055fed13042c.png" alt="Google Tag Manager" loading="lazy"></div><span>Tag Manager</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-b32a0e36fdab.png" alt="Google Search Console" loading="lazy"></div><span>Search Console</span></div>
        </div>
      </div>
      <div class="tools-cat">
        <h3 data-i18n="tools_cat4">AI &amp; Productivity</h3>
        <div class="tools-icon-row">
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-bc4935657e86.png" alt="Claude AI" loading="lazy"></div><span>Claude AI</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-a077fd0cc438.png" alt="ChatGPT" loading="lazy"></div><span>ChatGPT</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-38a2ce323997.png" alt="Gemini" loading="lazy"></div><span>Gemini</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-d9168d6f790c.png" alt="Magnific AI" loading="lazy"></div><span>Magnific AI</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-fee42bc9b96c.png" alt="Envato Elements" loading="lazy"></div><span>Envato Elements</span></div>
        </div>
      </div>
      <div class="tools-cat">
        <h3 data-i18n="tools_cat3">Digital Advertising</h3>
        <div class="tools-icon-row">
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-cd47ca03b973.png" alt="Meta Ads Manager" loading="lazy"></div><span>Ads Manager</span></div>
          <div class="tool-item"><div class="tool-logo"><img src="assets/img/img-5a1608d58abf.png" alt="WhatsApp Business" loading="lazy"></div><span>WhatsApp Business</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint" style="padding:90px 0;">
  <div class="wrap">
    <div class="cd-wrap">
      <div class="section-head reveal" style="margin-bottom:24px;">
        <h2 data-i18n="impact_label">Project Impact</h2>
      </div>
      <p class="cd-summary reveal" data-i18n="impact_p1" style="margin:0 0 20px;">Through a combination of content strategy and digital marketing, Umroh Rekivatour now has a more consistent and professional digital presence.</p>
      <p class="cd-summary reveal" data-i18n="impact_p2" style="margin:0;">This approach helps the business reach a wider audience, strengthen brand credibility, and build a digital marketing foundation that can keep growing alongside the business.</p>
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <h2 data-i18n="cta_h2">Want Similar Results for Your Business?</h2>
    <p data-i18n="cta_p">Let's discuss the digital marketing strategy that fits your brand &mdash; free initial consultation.</p>
    <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="cta_btn">Start a Project &rarr;</a>
  </div>
</section>


