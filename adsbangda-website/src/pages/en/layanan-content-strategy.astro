  dapat_h: {id:'Yang Kamu Dapat', en:'What You Get'},
  inc1: {id:'Riset kompetitor &amp; positioning brand', en:'Competitor research &amp; brand positioning'},
  inc2: {id:'Penentuan content pillar sesuai tujuan bisnis', en:'Content pillar planning aligned with business goals'},
  inc3: {id:'Kalender editorial bulanan/kuartalan', en:'Monthly/quarterly editorial calendar'},
  inc4: {id:'Panduan hook &amp; storytelling per platform', en:'Hook &amp; storytelling guidelines per platform'},
  inc5: {id:'Evaluasi &amp; penyesuaian strategi berkala', en:'Regular strategy evaluation &amp; adjustment'},
  cta_btn: {id:'Konsultasi Layanan Ini &rarr;', en:'Consult About This Service &rarr;'},
  other_h2: {id:'Butuh yang lain juga?', en:'Need Something Else Too?'},
  other1_p: {id:'Produksi konten harian/mingguan — dari naskah, syuting, sampai desain feed yang konsisten ...', en:'Daily/weekly content production — from scripting and filming to consistent feed design ...'},
  other2_p: {id:'Naikin konten organic terbaik jadi campaign ads yang terarah dan performing di Instagram &...', en:'Turn your best organic content into targeted, high-performing ad campaigns on Instagram &...'},
  other3_p: {id:'Matchmaking brand dengan key opinion leader dan influencer yang suaranya emang cocok sama ...', en:'Matching brands with key opinion leaders and influencers whose voice actually fits ...'},
  link_more: {id:'Lihat Detail &rarr;', en:'See Details &rarr;'},
