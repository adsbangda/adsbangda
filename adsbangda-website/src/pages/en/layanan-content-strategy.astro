---
import Layout from "../../layouts/Layout.astro";
const title = 'Content Strategy Services | Adsbangda';
const description = 'Trend research, content calendars, and 3-second hooks that make people stop scrolling. Build a clear content direction for your business.';

const serviceSchema = {
  "@type": "Service",
  "@id": "https://www.adsbangda.com/layanan-content-strategy.html#service",
  name: "Content Strategy",
  serviceType: "Content Strategy",
  description: "Jasa penyusunan strategi konten -- riset kompetitor, content pillar, kalender editorial, hingga panduan hook & storytelling per platform.",
  provider: { "@id": "https://www.adsbangda.com/#organization" },
  areaServed: "ID",
  url: "https://www.adsbangda.com/layanan-content-strategy.html",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Content Strategy",
    itemListElement: [
      "Riset kompetitor & positioning brand",
      "Penentuan content pillar sesuai tujuan bisnis",
      "Kalender editorial bulanan/kuartalan",
      "Panduan hook & storytelling per platform",
      "Evaluasi & penyesuaian strategi berkala",
    ].map((name) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name } })),
  },
};
---
<Layout title={title} description={description} path="en/layanan-content-strategy.html" lang="id" lang="en" hreflangId="layanan-content-strategy.html" portfolioCss={false} extraSchema={serviceSchema}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }



<section class="service-page-hero">
  <div class="wrap">
    <div class="breadcrumb"><a href="layanan.html" data-i18n-nav="layanan">Layanan</a> / <span data-i18n="svc_name">Content Strategy</span></div>
    <div class="service-icon"><svg aria-hidden="true" focusable="false" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M4 19V10M12 19V5M20 19v-7"/></svg></div>
    <h1 data-i18n="hero_h1">Content Strategy</h1>
    <p class="lede" data-i18n="hero_p">Trend research, content calendars, and 3-second hooks that stop people from scrolling. We help your business have a clear content direction — not just random posting without purpose.</p>
    <div class="tag-row"><span data-i18n="tag1">Market Research</span><span data-i18n="tag2">Content Pillar</span><span data-i18n="tag3">Trend Analysis</span><span data-i18n="tag4">Editorial Calendar</span></div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="service-detail-grid">
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:14px;" data-i18n="cocok_h">Who Is This For?</h2>
        <p style="font-size:15px;line-height:1.75;color:#3b3d3a;text-align:justify;" data-i18n="cocok_p">A great fit for businesses that already post regularly but feel their content direction is still unclear or results have stalled.</p>
      </div>
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:16px;" data-i18n="dapat_h">What You Get</h2>
        <ul class="include-list">
          <li><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc1">Competitor research &amp; brand positioning</span></li><li><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc2">Content pillar planning aligned with business goals</span></li><li><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc3">Monthly/quarterly editorial calendar</span></li><li><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc4">Hook &amp; storytelling guidelines per platform</span></li><li><svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc5">Regular strategy evaluation &amp; adjustment</span></li>
        </ul>
        <div class="service-cta-row">
          <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="cta_btn">Consult About This Service &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 style="font-size:24px;" data-i18n="other_h2">Need Something Else Too?</h2>
    </div>
    <div class="service-simple-grid">
      <a href="layanan-sosial-media-management.html" class="service-simple-card reveal">
        <div class="service-icon"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><rect x="3" y="6" width="14" height="12" rx="2"/><path d="M17 10l4-2v8l-4-2"/></svg></div>
        <h3>Social Media Management</h3>
        <p data-i18n="other1_p">Daily/weekly content production — from scripting and filming to consistent feed design ...</p>
        <div class="link-more" data-i18n="link_more">See Details &rarr;</div>
      </a><a href="layanan-meta-ads.html" class="service-simple-card reveal">
        <div class="service-icon"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r=".6" fill="#15171B"/></svg></div>
        <h3>Meta Ads Performance</h3>
        <p data-i18n="other2_p">Turn your best organic content into targeted, high-performing ad campaigns on Instagram &...</p>
        <div class="link-more" data-i18n="link_more">See Details &rarr;</div>
      </a><a href="layanan-kol-management.html" class="service-simple-card reveal">
        <div class="service-icon"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 20c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6"/><circle cx="17.5" cy="9" r="2.3"/><path d="M15.5 20c0-2.8 1.6-5 3.8-5"/></svg></div>
        <h3>KOL & Influencer Management</h3>
        <p data-i18n="other3_p">Matching brands with key opinion leaders and influencers whose voice actually fits ...</p>
        <div class="link-more" data-i18n="link_more">See Details &rarr;</div>
      </a>
    </div>
  </div>
</section>


<Fragment slot="page-scripts">
<script is:inline>


// ---- shared nav/footer translation (site-wide, all pages) ----
const translations = {
  svc_name: {id:'Content Strategy', en:'Content Strategy'},
  hero_h1: {id:'Content Strategy', en:'Content Strategy'},
  hero_p: {id:'Riset tren, kalender konten, dan hook 3 detik pertama yang bikin orang berhenti scroll. Kami bantu bisnis kamu punya arah konten yang jelas — bukan cuma posting random tanpa tujuan.', en:'Trend research, content calendars, and 3-second hooks that stop people from scrolling. We help your business have a clear content direction — not just random posting without purpose.'},
  tag1: {id:'Market Research', en:'Market Research'},
  tag2: {id:'Content Pillar', en:'Content Pillar'},
