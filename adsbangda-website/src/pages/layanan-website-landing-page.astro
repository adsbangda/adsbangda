---
import Layout from "../layouts/Layout.astro";
const title = 'Jasa Website & Landing Page | Adsbangda';
const description = 'Website atau landing page yang bukan cuma bagus dilihat, tapi dirancang untuk mengonversi pengunjung jadi leads. Cepat, responsif, mudah di-update.';

const serviceSchema = {
  "@type": "Service",
  "@id": "https://www.adsbangda.com/layanan-website-landing-page.html#service",
  name: "Website & Landing Page",
  serviceType: "Web Design & Development",
  description: "Jasa pembuatan website dan landing page yang fokus konversi -- konsultasi struktur halaman, desain, copywriting, pengembangan responsif, hingga integrasi tracking.",
  provider: { "@id": "https://www.adsbangda.com/#organization" },
  areaServed: "ID",
  url: "https://www.adsbangda.com/layanan-website-landing-page.html",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website & Landing Page",
    itemListElement: [
      "Konsultasi kebutuhan & struktur halaman",
      "Desain & copywriting yang fokus ke konversi",
      "Pengembangan website/landing page responsif",
      "Integrasi WhatsApp, form, atau tracking (Pixel, Analytics)",
      "Revisi sampai hasil sesuai ekspektasi",
    ].map((name) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name } })),
  },
};
---
<Layout title={title} description={description} path="layanan-website-landing-page.html" portfolioCss={false} extraSchema={serviceSchema}>
{ /* head-style slot: CSS khusus halaman ini (kalau ada) */ }



<section class="service-page-hero">
  <div class="wrap">
    <div class="breadcrumb"><a href="layanan.html" data-i18n-nav="layanan">Layanan</a> / <span data-i18n="svc_name">Website & Landing Page</span></div>
    <div class="service-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><circle cx="6" cy="6.5" r=".6" fill="#15171B"/><circle cx="8.5" cy="6.5" r=".6" fill="#15171B"/></svg></div>
    <h1 data-i18n="hero_h1">Website & Landing Page</h1>
    <p class="lede" data-i18n="hero_p">Bikin website atau landing page yang bukan cuma bagus dilihat, tapi juga dirancang buat mengonversi pengunjung jadi leads atau pelanggan. Cepat, responsif, dan gampang di-update.</p>
    <div class="tag-row"><span data-i18n="tag1">Landing Page</span><span data-i18n="tag2">Company Profile Web</span><span data-i18n="tag3">Conversion-Focused</span><span data-i18n="tag4">Mobile Responsive</span></div>
  </div>
</section>

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="service-detail-grid">
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:14px;" data-i18n="cocok_h">Cocok Buat Siapa?</h2>
        <p style="font-size:15px;line-height:1.75;color:#3b3d3a;text-align:justify;" data-i18n="cocok_p">Cocok buat bisnis yang belum punya website, atau yang websitenya udah ada tapi terasa kuno dan nggak mengonversi.</p>
      </div>
      <div class="reveal">
        <h2 style="font-size:22px;margin-bottom:16px;" data-i18n="dapat_h">Yang Kamu Dapat</h2>
        <ul class="include-list">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc1">Konsultasi kebutuhan &amp; struktur halaman</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc2">Desain &amp; copywriting yang fokus ke konversi</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc3">Pengembangan website/landing page responsif</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc4">Integrasi WhatsApp, form, atau tracking (Pixel, Analytics)</span></li><li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#FF4A3D" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg> <span data-i18n="inc5">Revisi sampai hasil sesuai ekspektasi</span></li>
        </ul>
        <div class="service-cta-row">
          <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" data-i18n="cta_btn">Konsultasi Layanan Ini &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 style="font-size:24px;" data-i18n="other_h2">Butuh yang lain juga?</h2>
    </div>
    <div class="service-simple-grid">
      <a href="layanan-sosial-media-management.html" class="service-simple-card reveal">
        <div class="service-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><rect x="3" y="6" width="14" height="12" rx="2"/><path d="M17 10l4-2v8l-4-2"/></svg></div>
        <h3>Social Media Management</h3>
        <p data-i18n="other1_p">Produksi konten harian/mingguan — dari naskah, syuting, sampai desain feed yang konsisten ...</p>
        <div class="link-more" data-i18n="link_more">Lihat Detail &rarr;</div>
      </a><a href="layanan-content-strategy.html" class="service-simple-card reveal">
        <div class="service-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M4 19V10M12 19V5M20 19v-7"/></svg></div>
        <h3>Content Strategy</h3>
        <p data-i18n="other2_p">Riset tren, kalender konten, dan hook 3 detik pertama yang bikin orang berhenti scroll. Ka...</p>
        <div class="link-more" data-i18n="link_more">Lihat Detail &rarr;</div>
      </a><a href="layanan-meta-ads.html" class="service-simple-card reveal">
        <div class="service-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r=".6" fill="#15171B"/></svg></div>
        <h3>Meta Ads Performance</h3>
        <p data-i18n="other3_p">Naikin konten organic terbaik jadi campaign ads yang terarah dan performing di Instagram &...</p>
        <div class="link-more" data-i18n="link_more">Lihat Detail &rarr;</div>
      </a>
    </div>
  </div>
</section>


<Fragment slot="page-scripts">
<script is:inline>


// ---- shared nav/footer translation (site-wide, all pages) ----
const translations = {
  svc_name: {id:'Website & Landing Page', en:'Website & Landing Page'},
  hero_h1: {id:'Website & Landing Page', en:'Website & Landing Page'},
  hero_p: {id:'Bikin website atau landing page yang bukan cuma bagus dilihat, tapi juga dirancang buat mengonversi pengunjung jadi leads atau pelanggan. Cepat, responsif, dan gampang di-update.', en:'We build websites or landing pages that aren\'t just good-looking, but designed to convert visitors into leads or customers. Fast, responsive, and easy to update.'},
  tag1: {id:'Landing Page', en:'Landing Page'},
  tag2: {id:'Company Profile Web', en:'Company Profile Web'},
  tag3: {id:'Conversion-Focused', en:'Conversion-Focused'},
