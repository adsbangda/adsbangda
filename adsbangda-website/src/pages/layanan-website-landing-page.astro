  inc2: {id:'Desain &amp; copywriting yang fokus ke konversi', en:'Conversion-focused design &amp; copywriting'},
  inc3: {id:'Pengembangan website/landing page responsif', en:'Responsive website/landing page development'},
  inc4: {id:'Integrasi WhatsApp, form, atau tracking (Pixel, Analytics)', en:'WhatsApp, form, or tracking integration (Pixel, Analytics)'},
  inc5: {id:'Revisi sampai hasil sesuai ekspektasi', en:'Revisions until the result meets expectations'},
  cta_btn: {id:'Konsultasi Layanan Ini &rarr;', en:'Consult About This Service &rarr;'},
  other_h2: {id:'Butuh yang lain juga?', en:'Need Something Else Too?'},
  other1_p: {id:'Produksi konten harian/mingguan — dari naskah, syuting, sampai desain feed yang konsisten ...', en:'Daily/weekly content production — from scripting and filming to consistent feed design ...'},
  other2_p: {id:'Riset tren, kalender konten, dan hook 3 detik pertama yang bikin orang berhenti scroll. Ka...', en:'Trend research, content calendars, and 3-second hooks that stop people from scrolling. We...'},
  other3_p: {id:'Naikin konten organic terbaik jadi campaign ads yang terarah dan performing di Instagram &...', en:'Turn your best organic content into targeted, high-performing ad campaigns on Instagram &...'},
