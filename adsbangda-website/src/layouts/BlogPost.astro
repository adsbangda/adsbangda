---
// Layout khusus untuk halaman artikel blog.
// Membungkus konten markdown dengan header artikel (judul, tanggal, breadcrumb)
// dan CTA di bagian bawah, lalu memakai Layout.astro utama untuk nav/footer.
import Layout from "./Layout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface RelatedPost {
  id: string;
  data: { title: string; category: string };
}

interface Props {
  title: string;
  description: string;
  category: string;
  date: string;
  readTime: string;
  path: string;
  headings?: Heading[];
  relatedPosts?: RelatedPost[];
}

const { title, description, category, date, readTime, path, headings = [], relatedPosts = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Layout title={`Adsbangda - ${title}`} description={description} path={path}>
<section class="article-header">
  <div class="wrap">
    <div class="breadcrumb"><a href="/blog.html">Blog</a> / <span>{category}</span></div>
    <h1>{title}</h1>
    <div class="article-meta-row">
      <span>Tim adsbangda</span>
      <span>&middot;</span>
      <span>{date}</span>
      <span>&middot;</span>
      <span>{readTime}</span>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="article-cover"></div>
</div>

<div class="wrap">
  <div class="article-layout">
    <div class="article-main">
      <div class="article-body">
        <slot />

        <div class="article-cta">
          <h3>Butuh Bantuan Mengelola Sosial Media Bisnis Kamu?</h3>
          <p>Tim kami bisa bantu susun strategi, produksi konten, sampai laporan performa bulanan.</p>
          <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" style="background:var(--yellow);color:var(--ink);">Konsultasi Gratis &rarr;</a>
        </div>
      </div>
    </div>

    <aside class="article-sidebar">
      <div class="sidebar-card sidebar-card-dark">
        <h4>Layanan</h4>
        <div class="sidebar-links sidebar-links-dark">
          <a href="/layanan-sosial-media-management.html">Social Media Management<span class="link-arrow">&rarr;</span></a>
          <a href="/layanan-content-strategy.html">Content Strategy<span class="link-arrow">&rarr;</span></a>
          <a href="/layanan-meta-ads.html">Meta Ads Performance<span class="link-arrow">&rarr;</span></a>
          <a href="/layanan-kol-management.html">KOL &amp; Influencer Management<span class="link-arrow">&rarr;</span></a>
          <a href="/layanan-branding-visual-identity.html">Branding &amp; Visual Identity<span class="link-arrow">&rarr;</span></a>
          <a href="/layanan-website-landing-page.html">Website &amp; Landing Page<span class="link-arrow">&rarr;</span></a>
          <a href="/layanan-creative-design.html">Creative Design<span class="link-arrow">&rarr;</span></a>
          <a href="/layanan-digital-growth-consulting.html">Digital Growth Consulting<span class="link-arrow">&rarr;</span></a>
        </div>
      </div>

      <div class="sidebar-card">
        <h4>Kontak</h4>
        <div class="sidebar-contact">
          <a href="mailto:info@adsbangda.com" class="sidebar-contact-item">
            <span class="sc-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#15171B" stroke-width="1.8"><path d="M4 4h16v16H4z"/><path d="M4 6l8 7 8-7"/></svg></span>
            <span>info@adsbangda.com</span>
