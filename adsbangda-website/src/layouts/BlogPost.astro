---
// Layout khusus untuk halaman artikel blog.
// Membungkus konten markdown dengan header artikel (judul, tanggal, breadcrumb)
// dan CTA di bagian bawah, lalu memakai Layout.astro utama untuk nav/footer.
import Layout from "./Layout.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface RelatedPost {
  id: string;
  data: { title: string; category: string };
}

interface Props {
  title: string;
  description: string;
  category: string;
  date: string;
  readTime: string;
  path: string;
  headings?: Heading[];
  relatedPosts?: RelatedPost[];
}

const { title, description, category, date, readTime, path, headings = [], relatedPosts = [] } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
<Layout title={`Adsbangda - ${title}`} description={description} path={path}>
<section class="article-header">
  <div class="wrap">
    <div class="breadcrumb"><a href="/blog.html">Blog</a> / <span>{category}</span></div>
    <h1>{title}</h1>
    <div class="article-meta-row">
      <span>Tim adsbangda</span>
      <span>&middot;</span>
      <span>{date}</span>
      <span>&middot;</span>
      <span>{readTime}</span>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="article-cover"></div>
</div>

<div class="wrap">
  <div class="article-layout">
    <div class="article-main">
      <div class="article-body">
        <slot />

        <div class="article-cta">
          <h3>Butuh Bantuan Mengelola Sosial Media Bisnis Kamu?</h3>
          <p>Tim kami bisa bantu susun strategi, produksi konten, sampai laporan performa bulanan.</p>
          <a href="#" target="_blank" rel="noopener" class="btn-primary wa-cta" data-wa-phone="6282289348724" style="background:var(--yellow);color:var(--ink);">Konsultasi Gratis &rarr;</a>
        </div>
      </div>
    </div>

    <aside class="article-sidebar">
      <div class="sidebar-card">
        <h4>Layanan</h4>
        <div class="sidebar-links">
          <a href="/layanan-sosial-media-management.html">Social Media Management</a>
          <a href="/layanan-content-strategy.html">Content Strategy</a>
          <a href="/layanan-meta-ads.html">Meta Ads Performance</a>
          <a href="/layanan-kol-management.html">KOL &amp; Influencer Management</a>
          <a href="/layanan-branding-visual-identity.html">Branding &amp; Visual Identity</a>
          <a href="/layanan-website-landing-page.html">Website &amp; Landing Page</a>
          <a href="/layanan-creative-design.html">Creative Design</a>
          <a href="/layanan-digital-growth-consulting.html">Digital Growth Consulting</a>
        </div>
      </div>

      <div class="sidebar-card">
        <h4>Kontak</h4>
        <div class="sidebar-links">
          <a href="mailto:info@adsbangda.com">info@adsbangda.com</a>
          <a href="#" target="_blank" rel="noopener" class="wa-cta" data-wa-phone="6282289348724">+62 822 8934 8724</a>
          <a href="#" target="_blank" rel="noopener" class="wa-cta" data-wa-phone="6281282262002">+62 812 8226 2002</a>
          <a href="#" target="_blank" rel="noopener" class="wa-cta" data-wa-phone="6285713644514">+62 857 1364 4514</a>
          <a href="/kontak.html">Jakarta, Indonesia</a>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <div class="sidebar-card">
          <h4>Artikel Terkait</h4>
          <div class="related-list">
            {relatedPosts.map((p) => (
              <a href={`/artikel-${p.id}.html`} class="related-item">
                <div class="rel-cat">{p.data.category}</div>
                <div class="rel-title">{p.data.title}</div>
              </a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</div>
</Layout>
