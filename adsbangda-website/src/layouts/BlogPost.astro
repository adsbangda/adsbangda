            <span>Jakarta, Indonesia</span>
          </a>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <div class="sidebar-card">
          <h4>Artikel Terkait</h4>
          <div class="related-list">
            {relatedPosts.map((p) => (
              <a href={`/artikel-${p.id}.html`} class="related-item">
                <div class="rel-cat">{p.data.category}</div>
                <div class="rel-title">{p.data.title}</div>
              </a>
            ))}
          </div>
        </div>
      )}
    </aside>
  </div>
</div>
</Layout>
